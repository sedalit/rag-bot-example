# =============================================================================
# DocsBot configuration. Copy to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.
# =============================================================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (psycopg3 dialect, used by both Alembic and the async engine)
# Use 127.0.0.1 (not localhost) to avoid IPv6 ::1 hangs under Docker Desktop.
DATABASE_URL=postgresql+psycopg://docsbot:docsbot@127.0.0.1:5432/docsbot
POSTGRES_USER=docsbot
POSTGRES_PASSWORD=docsbot
POSTGRES_DB=docsbot
# Must match the embedding model's output dimension (text-embedding-3-small = 1536)
EMBEDDING_DIM=1536

# OpenAI-compatible provider (change base_url/model to swap providers)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Ingestion
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3

# Retrieval
TOP_K=5
RELEVANCE_THRESHOLD=0.45

# Dialogue memory
MEMORY_SIZE=6

# REST API
API_HOST=0.0.0.0
API_PORT=8000
MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Telegram bot (optional; leave disabled unless a token is provided)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
