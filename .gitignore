# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# uv-managed cache and toolchains (kept inside the workspace)
.uv/

# Environment files (secrets must not be committed)
.env
.env.*
!.env.example

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# IDEs / editors
.idea/
.vscode/
*.swp

# Evaluation results (regenerated by eval.run)
eval/results/*.json

# Postgres / Docker data
pgdata/

# OS
.DS_Store
Thumbs.db
